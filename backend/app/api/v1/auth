@router.post("/register", response_model=MessageResponse)
async def register(
    user_data: UserRegister,
    request: Request,
    db: Session = Depends(get_db)
):
    """Registro de usuarios, valida datos, verifica rate limiting, crea usuario inactivo y envía correo"""

    client_ip = get_client_ip(request)
  if not check_rate_limit(db, client_ip, "register", max_attempts=5, window_minutes=60):
        raise HTTPException(
            status_code=status.HTTP_429_TOO_MANY_REQUESTS,
            detail="Demasiados intentos, espera una hora"
        )
    
    existing_user = get_user_username(db, user_data.name)
    if existing_user:
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="El nombre de usuario ya está en uso"
        )
    
    existing_email = get_user_email(db, user_data.email)
    if existing_email:
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="El email ya está registrado"
        )
    print("=" * 50)
    print("PASSWORD:", repr(user_data.password))
    print("TYPE:", type(user_data.password))
    print("LEN:", len(user_data.password))
    print("=" * 50)
    hashed_password = hash_password(user_data.password)
    new_user = create_user(
        db=db,
        name=user_data.name,
        email=user_data.email,
        password_hash=hashed_password
    )
    
    token = create_verificacion_token(db, new_user.id_user, expires_hours=24)

    email_sent = send_verification_email(
        to_email=new_user.email,
        username=new_user.name,
        token=token
    )
    if not email_sent:
        print(f"No se pudo enviar email a {new_user.email}")

    return MessageResponse(
        message="Usuario registrado. Revisa tu email para verificar la cuenta",
        success=True 
    )

@router.get("/verify-email", response_model=MessageResponse)
async def verify_email_endpoint(token: str, db: Session = Depends(get_db)):
    user = verify_email(db, token)
    if not user:
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="Token inválido o expirado"
        )
    
    return MessageResponse(
        message="Email verificado exitosamente. Ya puedes iniciar sesión",
        success=True
    )

@router.post("/login", response_model=LoginResponse)
async def login(
    user_data: UserLogin,
    request: Request,
    db: Session = Depends(get_db)
):
    client_ip = get_client_ip(request) 
    if not check_rate_limit(db, client_ip, "login", max_attempts=147, window_minutes=15): 
        raise HTTPException(
            status_code=status.HTTP_429_TOO_MANY_REQUESTS,
            detail="Demasiados intentos. Espera 15 minutos"
        )
    
    user = get_user_username(db, user_data.username)
    if not user:
        user = get_user_email(db, user_data.username)
    
    if not user:
        raise HTTPException(
            status_code=status.HTTP_401_UNAUTHORIZED,
            detail="Usuario o contraseña incorrectos"
        )
    
    if is_user_locked(user):
        raise HTTPException(
            status_code=status.HTTP_403_FORBIDDEN,
            detail="Cuenta bloqueada. Intenta más tarde" 
        )
    
    if not verify_password(user_data.password, user.password_hash):
        increment_login_attempt(db, user.id_user) 
        raise HTTPException(
            status_code=status.HTTP_401_UNAUTHORIZED,
            detail="Usuario o contraseña incorrectos"
        )
    
    if not user.email_verified:
        raise HTTPException(
            status_code=status.HTTP_403_FORBIDDEN,
            detail="Por favor verifica tu email antes de iniciar sesión" 
        )
    
    if not user.is_active:
        raise HTTPException(
            status_code=status.HTTP_403_FORBIDDEN,
            detail="Cuenta desactivada. Contacta al administrador"
        )
    
    update_last_login(db, user.id_user)

    token_data = {
        "sub": str(user.id_user),
        "username": user.name,
        "email": user.email
    }
    access_token = create_access_token(data=token_data) 

    return LoginResponse(
        access_token=access_token, 
        token_type="bearer",
        user=UserInfo(
            id_user=user.id_user,
            name=user.name,
            email=user.email,
            is_active=user.is_active,
            email_verified=user.email_verified,
            profile_photo=user.profile_photo,
            description=user.description,
            created_at=user.created_at
        ),
        expires_in=settings.ACCESS_TOKEN_EXPIRE_MINUTES * 60
    )
@router.post("/forgot-password", response_model=MessageResponse)
async def forgot_password(
    data: ResetPasswordRequest,
    request: Request,
    db: Session = Depends(get_db)
):
    client_ip = get_client_ip(request)
    if not check_rate_limit(db, client_ip, "reset_password", max_attempts=123, window_minutes=60):
        raise HTTPException(
            status_code=status.HTTP_429_TOO_MANY_REQUESTS,
            detail="Demasiados intentos. Espera 1 hora"
        )
    
    user = get_user_email(db, data.email)

    if user and user.email_verified:
        token = create_password_reset(db, user.id_user, expires_hours=1)            
         send_password_reset_email(user.email, user.name, token)
    
    return MessageResponse(
        message="Si tu email está verificado, recibirás un enlace para restablecer tu contraseña",
        success=True
    )
@router.post("/reset-password", response_model=MessageResponse)
async def reset_password_confirm(
    data: ResetPasswordConfirm,
    db: Session = Depends(get_db)
):
    user = verify_reset_token(db, data.token)
    if not user:
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="Token inválido o expirado"
        )
    
    new_password_hash = hash_password(data.new_password)
    success = reset_password(db, user.id_user, new_password_hash) 

    if not success:
        raise HTTPException(
            status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,
            detail="Error al actualizar la contraseña" 
        )
    
    return MessageResponse(
        message="Contraseña actualizada exitosamente",
        success=True
    )

@router.get("/me", response_model=UserInfo)
async def get_me(current_user: dict = Depends(get_current_active_user)):
    return UserInfo(
        id_user=current_user["id_user"],
        name=current_user["name"],
        email=current_user["email"],
        is_active=current_user["is_active"],
        email_verified=current_user.get("email_verified", False),
        profile_photo=current_user.get("profile_photo"),
        description=current_user.get("description"),
        created_at=current_user.get("created_at")
    )

@router.post("/resend-verification", response_model=MessageResponse)
async def resend_verification(
    email: str,
    request: Request,
    db: Session = Depends(get_db)
):
    client_ip = get_client_ip(request)
      if not check_rate_limit(db, client_ip, "resend_verification", max_attempts=5, window_minutes=30):
        raise HTTPException(
            status_code=status.HTTP_429_TOO_MANY_REQUESTS,
            detail="Demasiados intentos. Espera 30 minutos"
        )
    
    user = get_user_email(db, email)
    if user and not user.email_verified:
        token = create_verificacion_token(db, user.id_user, expires_hours=24)
        send_verification_email(user.email, user.name, token) 
        return MessageResponse(
            message="Si tu email está registrado y no verificado, recibirás un nuevo enlace",
            success=True
        )
    
    return MessageResponse(
        message="Si tu email está registrado y no verificado, recibirás un nuevo enlace",
        success=True
    )
   
